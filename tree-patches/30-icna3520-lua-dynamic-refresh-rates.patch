+    dynamic_refresh_rates = {
+        40, 50, 60, 120
+    },
+
+    dynamic_modegen = function(base_mode, refresh)
+        local mode = base_mode
+
+        -- Everything except the front porch is fixed: vdisplay + vsync + vbp.
+        local fixed_lines = mode.vtotal - (mode.vsync_start - mode.vdisplay)
+        local vtotal = math.floor((mode.clock * 1000) / (mode.htotal * refresh))
+        local vfp = vtotal - fixed_lines
+
+        if vfp < 1 then
+            warn("[icna3520] "..refresh.."Hz is above the panel's base rate, ignoring")
+            return base_mode
+        end
+
+        gamescope.modegen.adjust_front_porch(mode, vfp)
+        mode.vrefresh = gamescope.modegen.calc_vrefresh(mode)
+
+        debug("[icna3520] "..refresh.."Hz -> front porch "..vfp..", vtotal "..mode.vtotal)
+        return mode
+    end,
